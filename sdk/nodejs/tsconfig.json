{
    "compilerOptions": {
        "outDir": "bin",
        "target": "es2016",
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "sourceMap": true,
        "stripInternal": true,
        "experimentalDecorators": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true
    },
    "files": [
        "config/index.ts",
        "config/vars.ts",
        "contaboInstanceReinstall.ts",
        "contaboInstanceValidation.ts",
        "cordonAndDrainBarrier.ts",
        "index.ts",
        "k3sAgent.ts",
        "k3sBinary.ts",
        "k3sDrain.ts",
        "k3sHealthGate.ts",
        "k3sServer.ts",
        "kubeconfig.ts",
        "localFileDelete.ts",
        "localFileRotate.ts",
        "nodeToken.ts",
        "provider.ts",
        "renderCloudInit.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
