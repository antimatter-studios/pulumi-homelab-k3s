node_modules/
Pulumi.*.yaml

# Hooks live in .git/hooks, installed per clone by github-guard. They are deliberately NOT
# tracked: git resolves a hook path when it runs the hook, which for a checkout is AFTER the
# working tree has been replaced — so an in-tree hooks directory reached through core.hooksPath
# lets any branch you check out rewrite the hook that runs next, with your credentials.
# .github-guard is the exception: it is data, and the guard reads its required checks from the server.
.githooks/*
!.github-guard
